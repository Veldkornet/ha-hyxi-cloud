{
  "config": {
    "step": {
      "user": {
        "title": "Home AssistantはどのようにHYXIシステムに接続すべきですか？",
        "description": "**HYXI Cloud**はどこでも動作し、アカウント内のすべてのデバイスをカバーしますが、HYXIのサーバーとインターネット接続に依存します。\n\n**ローカルModbus**はRS485経由で1台のインバーターと直接通信します。配線とアダプターが必要ですが、はるかに高速にポーリングし、インターネットがなくても動作し続け、クラウドAPIが拒否するデバイスも制御できます。",
        "data": {
          "transport": "接続方法"
        }
      },
      "reauth_confirm": {
        "title": "HYXI Cloudの再認証",
        "description": "アクセスキーまたはシークレットキーが無効です。ソーラー監視を再開するには、新しい資格情報を入力してください。これらは[HYXIPOWER開発者プラットフォーム]({link})で見つけることができます。 アカウントが別のサーバーリージョンに移動された場合は、以下で修正できます。",
        "data": {
          "access_key": "アクセスキー (AK)",
          "secret_key": "シークレットキー (SK)",
          "region": "サーバーリージョン"
        }
      },
      "cloud": {
        "title": "HYXI Cloudに接続",
        "description": "**開発者API資格情報 (AK/SK)**を入力してください。これらは[HYXIPOWER開発者プラットフォーム]({link})で作成できます。\n\n**注意:** 別途開発者アカウントが必要です。開発者用メールアドレスがアプリ用メールアドレスと異なる場合は、まずアプリから開発者用メールアドレスに**発電所を共有**する必要があります。",
        "data": {
          "access_key": "アクセスキー (AK)",
          "secret_key": "シークレットキー (SK)",
          "region": "サーバーリージョン"
        }
      },
      "modbus": {
        "title": "RS485バスはどのように接続されていますか？",
        "description": "Home AssistantがインバーターのRS485端子にどのように接続するかを選択してください。\n\n**Modbus TCPゲートウェイ**はインバーターの近くに設置され、ネットワーク経由でアクセスします。**シリアルポート**は、Home Assistantを実行しているマシンに接続されたUSB-RS485アダプターです。",
        "data": {
          "modbus_type": "接続タイプ"
        }
      },
      "modbus_tcp": {
        "title": "Modbus TCPゲートウェイ",
        "description": "RS485-Ethernetゲートウェイのアドレスを入力してください。\n\n**スレーブアドレス**はインバーターのModbus IDで、変更していなければ1です。複数のデバイスがバスを共有している場合、それぞれに固有のアドレスが必要です。",
        "data": {
          "modbus_host": "ゲートウェイのホストまたはIPアドレス",
          "modbus_port": "ポート",
          "modbus_unit": "スレーブアドレス"
        }
      },
      "modbus_serial": {
        "title": "シリアルポート",
        "description": "USB-RS485アダプターのシリアルデバイスを入力してください（例：`/dev/ttyUSB0`）。\n\nインバーター側で変更していなければ、工場出荷時のボーレートのままにしてください。**スレーブアドレス**はインバーターのModbus IDで、デフォルトは1です。",
        "data": {
          "modbus_device": "シリアルデバイス",
          "modbus_baudrate": "ボーレート",
          "modbus_unit": "スレーブアドレス"
        }
      },
      "reconfigure": {
        "title": "RS485バスはどのように接続されていますか？",
        "description": "ネットワークゲートウェイとUSBアダプターを切り替えた場合は接続タイプを変更し、そうでなければ現在の設定のまま続行してください。",
        "data": {
          "modbus_type": "接続タイプ"
        }
      },
      "reconfigure_tcp": {
        "title": "Modbus TCPゲートウェイ",
        "description": "RS485-Ethernetゲートウェイの詳細を更新してください。保存前に接続が再テストされ、デバイスが再識別されます。",
        "data": {
          "modbus_host": "ゲートウェイのホストまたはIPアドレス",
          "modbus_port": "ポート",
          "modbus_unit": "スレーブアドレス"
        }
      },
      "reconfigure_serial": {
        "title": "シリアルポート",
        "description": "USB-RS485アダプターの詳細を更新してください。保存前に接続が再テストされ、デバイスが再識別されます。",
        "data": {
          "modbus_device": "シリアルデバイス",
          "modbus_baudrate": "ボーレート",
          "modbus_unit": "スレーブアドレス"
        }
      }
    },
    "error": {
      "cannot_connect": "HYXIサーバーへの接続に失敗しました",
      "invalid_auth": "アクセスキーまたはシークレットキーが無効です",
      "unknown": "予期しないエラーが発生しました",
      "no_devices": "プラントまたはデバイスが見つかりません。開発者用メールアドレスがアプリ用メールアドレスと異なる場合は、まずアプリから開発者用メールアドレスにプラントを共有する必要があります。",
      "no_device": "バス上で応答がありませんでした。配線、スレーブアドレス、ボーレートを確認してください。",
      "gateway_unreachable": "ゲートウェイへの接続に失敗しました。ホストとポート、電源が入っていること、ネットワーク上で到達可能であることを確認してください。",
      "modbus_unavailable": "Modbusサポートがインストールされていません。Home Assistantを再起動してもう一度お試しください。",
      "unidentified_family": "デバイスから応答がありましたが、対応するHALOまたはハイブリッドインバーターであることを確認できませんでした。スレーブアドレス、または対応モデルかどうかを確認してください。"
    },
    "abort": {
      "already_configured": "このHYXIアカウントは既に設定されています。",
      "reauth_successful": "再認証に成功しました",
      "reconfigure_successful": "Modbus接続が正常に更新されました。"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "HYXIシステム設定",
        "description": "統合がHYXIと通信する方法を調整します。\n\n> ⚠️ **デバイス制御**: インバーターがすでに電力会社によって管理されている場合、または仮想発電所（VPP）プログラムに登録されている場合は、慎重に有効にしてください。電力会社が制御している間にコマンドを送信すると、そのディスパッチスケジュールと競合する可能性があります。\n\n---",
        "data": {
          "update_interval": "ポーリング間隔 (1-60分, デフォルト: 5)",
          "update_interval_modbus": "ポーリング間隔 (1-60秒, デフォルト: 15)",
          "back_discovery": "アラーム経由の検出を有効にする (高度)",
          "enable_battery_control": "デバイス制御と保護を有効にする",
          "enable_energy_manager": "エネルギーマネージャー スタンドアロンを有効にする (ベータ)",
          "enable_realtime_push": "リアルタイムWebhookプッシュを有効にする",
          "realtime_push_rate": "プッシュ更新頻度 (ミリ秒, 範囲: 5000-3600000)",
          "realtime_push_url": "カスタムコールバックURL (オプション, 動的デフォルト)"
        }
      },
      "energy_manager": {
        "title": "エネルギーマネージャー",
        "description": "太陽光発電量、系統メーター、予測データに基づいてバッテリー使用を最適化するようにエネルギーマネージャーを設定します。",
        "data": {
          "em_p1_entity": "P1スマートメーター (電力センサー)",
          "em_forecast_entity": "本日の残り太陽光予測 (オプション)",
          "em_forecast_power_entity": "現在の太陽光予測電力 (オプション)",
          "em_inverter_sn": "制御対象のインバーター",
          "em_battery_capacity_override": "バッテリー容量を上書き",
          "em_battery_capacity_wh": "バッテリー容量 (Wh)",
          "em_loop_interval": "判定ループ間隔 (秒)",
          "em_dry_run": "ドライラン モード (API呼び出しなし)"
        }
      }
