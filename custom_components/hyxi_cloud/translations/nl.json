{
  "config": {
    "step": {
      "user": {
        "title": "How should Home Assistant reach your HYXI system?",
        "description": "**HYXI Cloud** works anywhere and covers every device on your account, but depends on HYXI's servers and your internet connection.\n\n**Local Modbus** talks straight to one inverter over RS485. It needs wiring and an adapter, but it polls far faster, keeps working when the internet doesn't, and can control devices the cloud API refuses.",
        "data": {
          "transport": "Connection method"
        }
      },
      "reauth_confirm": {
        "title": "HYXI Cloud opnieuw verifiëren",
        "description": "Uw Access Key of Secret Key is niet meer geldig. Voer uw nieuwe inloggegevens in om de zonnemonitoring te hervatten. U kunt deze vinden op het [HYXIPOWER Developer Platform]({link}). Als uw account naar een andere serverregio is verplaatst, kunt u dit hieronder corrigeren.",
        "data": {
          "access_key": "Toegangssleutel (AK)",
          "secret_key": "Geheime Sleutel (SK)",
          "region": "Serverregio"
        }
      },
      "cloud": {
        "title": "Verbinden met HYXI Cloud",
        "description": "Voer uw **Developer API-gegevens (AK/SK)** in. U kunt deze genereren op het [HYXIPOWER Developer Platform]({link}).\n\n**Opmerking:** Dit vereist een apart ontwikkelaarsaccount. Als uw e-mailadres voor ontwikkelaars afwijkt van uw app-e-mailadres, moet u eerst uw installatie vanuit de app **delen** met het e-mailadres voor ontwikkelaars.",
        "data": {
          "access_key": "Toegangssleutel (AK)",
          "secret_key": "Geheime Sleutel (SK)",
          "region": "Serverregio"
        }
      },
      "modbus": {
        "title": "How is the RS485 bus connected?",
        "description": "Choose how Home Assistant reaches the inverter's RS485 terminals.\n\nA **Modbus TCP gateway** sits near the inverter and is reached over your network. A **serial port** is a USB RS485 adapter plugged into the machine running Home Assistant.",
        "data": {
          "modbus_type": "Connection type"
        }
      },
      "modbus_tcp": {
        "title": "Modbus TCP gateway",
        "description": "Enter the address of the RS485-to-Ethernet gateway.\n\nThe **slave address** is the inverter's Modbus ID, which is 1 unless you have changed it. If several devices share the bus, each needs its own.",
        "data": {
          "modbus_host": "Gateway host or IP address",
          "modbus_port": "Port",
          "modbus_unit": "Slave address"
        }
      },
      "modbus_serial": {
        "title": "Serial port",
        "description": "Enter the serial device for your USB RS485 adapter, for example `/dev/ttyUSB0`.\n\nKeep the factory baud rate unless you have changed it on the inverter. The **slave address** is the inverter's Modbus ID, which is 1 by default.",
        "data": {
          "modbus_device": "Serial device",
          "modbus_baudrate": "Baud rate",
          "modbus_unit": "Slave address"
        }
      },
      "reconfigure": {
        "title": "How is the RS485 bus connected?",
        "description": "Change the connection type if you've switched between a network gateway and a USB adapter, or keep the current one to continue.",
        "data": {
          "modbus_type": "Connection type"
        }
      },
      "reconfigure_tcp": {
        "title": "Modbus TCP gateway",
        "description": "Update the RS485-to-Ethernet gateway's details. The connection is re-tested and the device re-identified before saving.",
        "data": {
          "modbus_host": "Gateway host or IP address",
          "modbus_port": "Port",
          "modbus_unit": "Slave address"
        }
      },
      "reconfigure_serial": {
        "title": "Serial port",
        "description": "Update the USB RS485 adapter's details. The connection is re-tested and the device re-identified before saving.",
        "data": {
          "modbus_device": "Serial device",
          "modbus_baudrate": "Baud rate",
          "modbus_unit": "Slave address"
        }
      }
    },
    "error": {
      "cannot_connect": "Kan geen verbinding maken met de HYXI servers",
      "invalid_auth": "Ongeldige Access Key of Secret Key",
      "unknown": "Er is een onverwachte fout opgetreden",
      "no_devices": "Geen installaties of apparaten gevonden. Als je ontwikkelaars-e-mailadres verschilt van je app-e-mailadres, moet je eerst je installatie vanuit de app delen met het ontwikkelaars-e-mailadres.",
      "no_device": "Nothing answered on the bus. Check the wiring, the slave address, and the baud rate.",
      "modbus_unavailable": "Modbus support is not installed. Restart Home Assistant and try again."
    },
    "abort": {
      "already_configured": "Dit HYXI account is al geconfigureerd.",
      "reauth_successful": "Herauthenticatie was succesvol",
      "reconfigure_successful": "The Modbus connection was updated successfully."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "HYXI Systeemconfiguratie",
        "description": "Pas aan hoe uw integratie communiceert met HYXI.\n\n> ⚠️ **Apparaatbediening**: Schakel dit voorzichtig in als uw omvormer al wordt beheerd door uw energieleverancier of is aangemeld voor een Virtual Power Plant (VPP)-programma. Het verzenden van commando's terwijl uw leverancier de controle heeft, kan in strijd zijn met hun dispatch-schema.\n\n---",
        "data": {
          "update_interval": "Update-interval (1-60 minuten, Standaard: 5)",
          "update_interval_modbus": "Update-interval (1-60 seconden, Standaard: 15)",
          "back_discovery": "Ontdekking via alarmen inschakelen (Geavanceerd)",
          "enable_battery_control": "Apparaatcontrole en -bescherming inschakelen",
          "enable_energy_manager": "Energiebeheer Standalone inschakelen (Beta)",
          "enable_realtime_push": "Realtime webhook-push inschakelen",
          "realtime_push_rate": "Push-updatefrequentie (milliseconden, bereik: 5000-3600000)",
          "realtime_push_url": "Aangepaste Callback-URL (optioneel, dynamische standaardwaarde)"
        }
      },
      "energy_manager": {
        "title": "Energiebeheer",
        "description": "Configureer Energiebeheer om het batterijgebruik te optimaliseren op basis van zonne-energieproductie, netmeter en voorspellingsgegevens.",
        "data": {
          "em_p1_entity": "P1 Slimme Meter (vermogenssensor)",
          "em_forecast_entity": "Zonneprognose Resterend Vandaag (optioneel)",
          "em_forecast_power_entity": "Zonneprognose Huidig Vermogen (optioneel)",
          "em_inverter_sn": "Te Besturen Omvormer",
          "em_battery_capacity_override": "Batterijcapaciteit Overschrijven",
          "em_battery_capacity_wh": "Batterijcapaciteit (Wh)",
          "em_loop_interval": "Beslislusinterval (seconden)",
          "em_dry_run": "Testmodus (geen API-aanroepen)"
        }
      }
    }
