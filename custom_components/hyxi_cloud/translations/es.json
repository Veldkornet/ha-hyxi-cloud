{
  "config": {
    "step": {
      "user": {
        "title": "How should Home Assistant reach your HYXI system?",
        "description": "**HYXI Cloud** works anywhere and covers every device on your account, but depends on HYXI's servers and your internet connection.\n\n**Local Modbus** talks straight to one inverter over RS485. It needs wiring and an adapter, but it polls far faster, keeps working when the internet doesn't, and can control devices the cloud API refuses.",
        "data": {
          "transport": "Connection method"
        }
      },
      "reauth_confirm": {
        "title": "Re-autenticar HYXI Cloud",
        "description": "Su clave de acceso o clave secreta ya no es válida. Ingrese sus nuevas credenciales para reanudar el monitoreo solar. Puede encontrarlas en la [Plataforma de desarrolladores de HYXIPOWER]({link}). Si su cuenta se trasladó a una región de servidor diferente, puede corregirlo a continuación.",
        "data": {
          "access_key": "Clave de acceso (AK)",
          "secret_key": "Clave secreta (SK)",
          "region": "Región del servidor"
        }
      },
      "cloud": {
        "title": "Conectarse a HYXI Cloud",
        "description": "Ingrese sus **credenciales de API de desarrollador (AK/SK)**. Puede generarlas en la [Plataforma de desarrolladores de HYXIPOWER]({link}).\n\n**Nota:** Esto requiere una cuenta de desarrollador independiente. Si su correo electrónico de desarrollador es diferente al de su aplicación, primero debe **Compartir su Planta** desde la aplicación al correo electrónico de desarrollador.",
        "data": {
          "access_key": "Clave de acceso (AK)",
          "secret_key": "Clave secreta (SK)",
          "region": "Región del servidor"
        }
      },
      "modbus": {
        "title": "How is the RS485 bus connected?",
        "description": "Choose how Home Assistant reaches the inverter's RS485 terminals.\n\nA **Modbus TCP gateway** sits near the inverter and is reached over your network. A **serial port** is a USB RS485 adapter plugged into the machine running Home Assistant.",
        "data": {
          "modbus_type": "Connection type"
        }
      },
      "modbus_tcp": {
        "title": "Modbus TCP gateway",
        "description": "Enter the address of the RS485-to-Ethernet gateway.\n\nThe **slave address** is the inverter's Modbus ID, which is 1 unless you have changed it. If several devices share the bus, each needs its own.",
        "data": {
          "modbus_host": "Gateway host or IP address",
          "modbus_port": "Port",
          "modbus_unit": "Slave address"
        }
      },
      "modbus_serial": {
        "title": "Serial port",
        "description": "Enter the serial device for your USB RS485 adapter, for example `/dev/ttyUSB0`.\n\nKeep the factory baud rate unless you have changed it on the inverter. The **slave address** is the inverter's Modbus ID, which is 1 by default.",
        "data": {
          "modbus_device": "Serial device",
          "modbus_baudrate": "Baud rate",
          "modbus_unit": "Slave address"
        }
      },
      "reconfigure": {
        "title": "How is the RS485 bus connected?",
        "description": "Change the connection type if you've switched between a network gateway and a USB adapter, or keep the current one to continue.",
        "data": {
          "modbus_type": "Connection type"
        }
      },
      "reconfigure_tcp": {
        "title": "Modbus TCP gateway",
        "description": "Update the RS485-to-Ethernet gateway's details. The connection is re-tested and the device re-identified before saving.",
        "data": {
          "modbus_host": "Gateway host or IP address",
          "modbus_port": "Port",
          "modbus_unit": "Slave address"
        }
      },
      "reconfigure_serial": {
        "title": "Serial port",
        "description": "Update the USB RS485 adapter's details. The connection is re-tested and the device re-identified before saving.",
        "data": {
          "modbus_device": "Serial device",
          "modbus_baudrate": "Baud rate",
          "modbus_unit": "Slave address"
        }
      }
    },
    "error": {
      "cannot_connect": "Error al conectar con los servidores de HYXI",
      "invalid_auth": "Clave de acceso o clave secreta no válida",
      "unknown": "Ocurrió un error inesperado",
      "no_devices": "No se encontraron plantas ni dispositivos. Si su correo electrónico de desarrollador es diferente al de su aplicación, primero debe compartir su planta desde la aplicación al correo electrónico de desarrollador.",
      "no_device": "Nothing answered on the bus. Check the wiring, the slave address, and the baud rate.",
      "modbus_unavailable": "Modbus support is not installed. Restart Home Assistant and try again."
    },
    "abort": {
      "already_configured": "Esta cuenta de HYXI ya está configurada.",
      "reauth_successful": "La re-autenticación fue exitosa",
      "reconfigure_successful": "The Modbus connection was updated successfully."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Configuración del Sistema HYXI",
        "description": "Ajuste cómo se comunica su integración con HYXI.\n\n> ⚠️ **Control del dispositivo**: Actívelo con precaución si su inversor ya está gestionado por su proveedor de energía o está inscrito en un programa de Planta de Energía Virtual (VPP). El envío de comandos mientras su proveedor tiene el control puede entrar en conflicto con su programa de despacho.\n\n---",
        "data": {
          "update_interval": "Intervalo de actualización (1-60 minutos, por defecto: 5)",
          "back_discovery": "Habilitar descubrimiento mediante alarmas (Avanzado)",
          "enable_battery_control": "Activar control y protección del dispositivo",
          "enable_energy_manager": "Activar Gestor de Energía Independiente (Beta)",
          "enable_realtime_push": "Activar Push Webhook en Tiempo Real",
          "realtime_push_rate": "Frecuencia de Actualización Push (milisegundos, rango: 5000-3600000)",
          "realtime_push_url": "URL de Callback Personalizada (opcional, valor predeterminado dinámico)"
        }
      },
      "energy_manager": {
        "title": "Gestor de Energía",
        "description": "Configure el Gestor de Energía para optimizar el uso de la batería según la producción solar, el medidor de red y los datos de previsión.",
        "data": {
          "em_p1_entity": "Medidor Inteligente P1 (sensor de potencia)",
          "em_forecast_entity": "Previsión Solar Restante Hoy (opcional)",
          "em_forecast_power_entity": "Previsión Solar Potencia Actual (opcional)",
          "em_inverter_sn": "Inversor a Controlar",
          "em_battery_capacity_override": "Anular Capacidad de la Batería",
          "em_battery_capacity_wh": "Capacidad de la Batería (Wh)",
          "em_loop_interval": "Intervalo del Bucle de Decisión (segundos)",
          "em_dry_run": "Modo de Prueba (sin llamadas API)"
        }
      }
    }
