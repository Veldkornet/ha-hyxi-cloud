  "options": {
    "step": {
      "init": {
        "title": "Configurazione del sistema HYXI",
        "description": "Regola il modo in cui la tua integrazione comunica con HYXI.\n\n> ⚠️ **Controllo del dispositivo**: Abilita con cautela se il tuo inverter è già gestito dal tuo fornitore di energia o è iscritto a un programma di Centrale Elettrica Virtuale (VPP). L'invio di comandi mentre il fornitore ha il controllo potrebbe entrare in conflitto con il suo programma di dispacciamento.\n\n---",
        "data": {
          "update_interval": "Intervallo di aggiornamento (1-60 Minuti, Predefinito: 5)",
          "update_interval_modbus": "Intervallo di aggiornamento (1-60 Secondi, Predefinito: 15)",
          "back_discovery": "Abilita il rilevamento tramite allarmi (Avanzato)",
          "enable_battery_control": "Abilita controllo e protezione dispositivo",
          "enable_energy_manager": "Abilita Gestore Energia Standalone (Beta)",
          "enable_realtime_push": "Abilita Push Webhook in Tempo Reale",
          "realtime_push_rate": "Frequenza di Aggiornamento Push (millisecondi, intervallo: 5000-3600000)",
          "realtime_push_url": "URL di Callback Personalizzato (opzionale, predefinito dinamico)"
        }
      },
      "energy_manager": {
        "title": "Gestore Energia",
        "description": "Configura il Gestore Energia per ottimizzare l'uso della batteria in base alla produzione solare, al contatore di rete e ai dati di previsione.",
        "data": {
          "em_p1_entity": "Smart Meter P1 (sensore di potenza)",
