    "step": {
      "user": {
        "title": "Hur ska Home Assistant nå ditt HYXI-system?",
        "description": "**HYXI Cloud** fungerar överallt och täcker alla enheter på ditt konto, men beror på HYXI:s servrar och din internetanslutning.\n\n**Lokal Modbus** kommunicerar direkt med en växelriktare via RS485. Det kräver kablage och en adapter, men avfrågar mycket snabbare, fortsätter fungera utan internet och kan styra enheter som moln-API:et avvisar.",
        "data": {
          "transport": "Anslutningsmetod"
        }
      },
      "reauth_confirm": {
        "title": "Återautentisera HYXI Cloud",
        "description": "Din åtkomstnyckel eller hemliga nyckel är inte längre giltig. Ange dina nya uppgifter för att återuppta solcellsövervakningen. Du hittar dessa på [HYXIPOWER Developer Platform]({link}). Om ditt konto har flyttats till en annan serverregion kan du rätta det nedan.",
        "data": {
          "access_key": "Åtkomstnyckel (AK)",
          "secret_key": "Hemlig nyckel (SK)",
          "region": "Serverregion"
        }
      },
