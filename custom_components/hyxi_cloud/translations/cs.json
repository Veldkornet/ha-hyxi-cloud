{
  "config": {
    "step": {
      "user": {
        "title": "How should Home Assistant reach your HYXI system?",
        "description": "**HYXI Cloud** works anywhere and covers every device on your account, but depends on HYXI's servers and your internet connection.\n\n**Local Modbus** talks straight to one inverter over RS485. It needs wiring and an adapter, but it polls far faster, keeps working when the internet doesn't, and can control devices the cloud API refuses.",
        "data": {
          "transport": "Connection method"
        }
      },
      "reauth_confirm": {
        "title": "Znovu ověřit HYXI Cloud",
        "description": "Váš přístupový klíč nebo tajný klíč již není platný. Zadejte prosím své nové údaje, abyste mohli pokračovat ve sledování solární elektrárny. Tyto údaje naleznete na [HYXIPOWER Developer Platform]({link}). Pokud byl váš účet přesunut na jiný region serveru, můžete to níže opravit.",
        "data": {
          "access_key": "Přístupový klíč (AK)",
          "secret_key": "Tajný klíč (SK)",
          "region": "Oblast serveru"
        }
      },
      "cloud": {
        "title": "Připojit k HYXI Cloud",
        "description": "Zadejte své **vývojářské API údaje (AK/SK)**. Tyto údaje si můžete vygenerovat na [HYXIPOWER Developer Platform]({link}).\n\n**Poznámka:** Vyžaduje to samostatný vývojářský účet. Pokud se váš vývojářský e-mail liší od e-mailu v aplikaci, musíte nejprve v aplikaci **nasdílet svou elektrárnu (Plant)** na vývojářský e-mail.",
        "data": {
          "access_key": "Přístupový klíč (AK)",
          "secret_key": "Tajný klíč (SK)",
          "region": "Oblast serveru"
        }
      },
      "modbus": {
        "title": "How is the RS485 bus connected?",
        "description": "Choose how Home Assistant reaches the inverter's RS485 terminals.\n\nA **Modbus TCP gateway** sits near the inverter and is reached over your network. A **serial port** is a USB RS485 adapter plugged into the machine running Home Assistant.",
        "data": {
          "modbus_type": "Connection type"
        }
      },
      "modbus_tcp": {
        "title": "Modbus TCP gateway",
        "description": "Enter the address of the RS485-to-Ethernet gateway.\n\nThe **slave address** is the inverter's Modbus ID, which is 1 unless you have changed it. If several devices share the bus, each needs its own.",
        "data": {
          "modbus_host": "Gateway host or IP address",
          "modbus_port": "Port",
          "modbus_unit": "Slave address"
        }
      },
      "modbus_serial": {
        "title": "Serial port",
        "description": "Enter the serial device for your USB RS485 adapter, for example `/dev/ttyUSB0`.\n\nKeep the factory baud rate unless you have changed it on the inverter. The **slave address** is the inverter's Modbus ID, which is 1 by default.",
        "data": {
          "modbus_device": "Serial device",
          "modbus_baudrate": "Baud rate",
          "modbus_unit": "Slave address"
        }
      },
      "reconfigure": {
        "title": "How is the RS485 bus connected?",
        "description": "Change the connection type if you've switched between a network gateway and a USB adapter, or keep the current one to continue.",
        "data": {
          "modbus_type": "Connection type"
        }
      },
      "reconfigure_tcp": {
        "title": "Modbus TCP gateway",
        "description": "Update the RS485-to-Ethernet gateway's details. The connection is re-tested and the device re-identified before saving.",
        "data": {
          "modbus_host": "Gateway host or IP address",
          "modbus_port": "Port",
          "modbus_unit": "Slave address"
        }
      },
      "reconfigure_serial": {
        "title": "Serial port",
        "description": "Update the USB RS485 adapter's details. The connection is re-tested and the device re-identified before saving.",
        "data": {
          "modbus_device": "Serial device",
          "modbus_baudrate": "Baud rate",
          "modbus_unit": "Slave address"
        }
      }
    },
    "error": {
      "cannot_connect": "Nepodařilo se připojit k serverům HYXI",
      "invalid_auth": "Neplatný přístupový klíč nebo tajný klíč",
